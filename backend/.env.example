# Copy this file to .env and adjust as needed. All fields have sensible
# local-dev defaults in app/core/config.py if you don't set them here.

ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

DATABASE_URL=sqlite:///./data/asl_vision.db

ML_CONFIG_PATH=ml_pipeline/configs/baseline.yaml
ML_CHECKPOINT_PATH=ml_pipeline/checkpoints/efficientnet_v2_s_baseline/best.pt
REQUIRE_MODEL_ON_STARTUP=false

MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=data/uploads

HISTORY_DEFAULT_LIMIT=50
HISTORY_MAX_LIMIT=500
